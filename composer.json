{
    "name": "puff/migration",
    "description": "Explicit PDO migrations for Puff",
    "type": "library",
    "keywords": [
        "database",
        "migration",
        "puff",
        "schema"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "puff/config": "dev-main",
        "puff/console": "dev-main",
        "puff/database": "dev-main",
        "puff/di": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Puff\\Migration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puff\\Migration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "puff": {
            "config": {"migration.php": "config/migration.php"},
            "providers": [
                "Puff\\Migration\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse src tests --level=8 --no-progress --memory-limit=1G",
        "test": "phpunit tests"
    }
}
